{
  "name": "ode",
  "version": "0.1.0",
  "private": true,
  "description": "Expressive, album-art-themed now-playing cards for GitHub READMEs, powered by Last.fm",
  "license": "SEE LICENSE IN LICENSE",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "preview": "node --experimental-strip-types scripts/preview.ts",
    "covers": "node --experimental-strip-types scripts/covers.ts",
    "check": "npm run typecheck && npm test"
  },
  "dependencies": {
    "fast-png": "^8.0.0",
    "jpeg-js": "^0.4.4"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261016.1",
    "@resvg/resvg-js": "^2.6.2",
    "@types/node": "^26.6.5",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5",
    "wrangler": "^4.156.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "workerd@1.20261012.1": true
  },
  "homepage": "https://ode.cl0ud-9.workers.dev",
  "author": "Cloud/9 (https://github.com/Cl0ud-9)",
  "keywords": [
    "lastfm",
    "now-playing",
    "github-profile",
    "readme",
    "svg",
    "cloudflare-workers",
    "material-you"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Cl0ud-9/Ode.git"
  },
  "bugs": {
    "url": "https://github.com/Cl0ud-9/Ode/issues"
  },
  "engines": {
    "node": ">=22"
  }
}
